SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional secure administrator provisioning. Leave all three empty to skip.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Copy the complete Supabase Postgres connection string into the local .env file.
SUPABASE_DB_URL=

# CNN model checkpoint. Default backend path is ../best_model.pth.
CNN_MODEL_PATH=

# Prefer remote Hugging Face Space FastAPI when set.
# Example: https://username-agromind-cnn-api.hf.space
CNN_API_URL=
CNN_API_TOKEN=

# Next.js frontend URL for CORS.
# The password-reset link is built from this, so in production it must be the
# public site URL, not localhost.
FRONTEND_ORIGIN=http://127.0.0.1:3000

# Outgoing mail, used by the password-reset flow.
#
# Prefer BREVO_API_KEY when SMTP delivery is unavailable or restricted.
# BREVO_API_KEY sends over HTTPS and wins over EMAIL_HOST when both are set.
# Brevo verifies a sender before production email can be delivered.
BREVO_API_KEY=
#
# SMTP settings below are kept for hosts that allow outbound SMTP.
# Leave EMAIL_HOST empty and the message is printed to the server log instead of
# sent — fine locally, but in production the grower never receives it.
# EMAIL_PORT 587 means STARTTLS, 465 means implicit TLS; the flags follow the
# port automatically, so only set EMAIL_USE_TLS/EMAIL_USE_SSL if your provider
# needs something else. Never commit real values.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10
# Must be an address the provider has authorised you to send from.
DEFAULT_FROM_EMAIL=Agromind AI <no-reply@agromind.farm>

# Optional (comma-separated) for multi-env deploys
# CORS_ALLOWED_ORIGINS=https://leafiq.example.com,https://staging-leafiq.example.com
CORS_ALLOWED_ORIGINS=
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=
# CSRF_TRUSTED_ORIGINS=https://api-leafiq.example.com
CSRF_TRUSTED_ORIGINS=

# SePay payment gateway
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
# Only for banks that will not report a transfer made straight to the master
# account. BIDV is one: SePay's QR builder says "BIDV yêu cầu chọn VA để tạo QR"
# and only records transfers arriving through the virtual account, so money sent
# to SEPAY_ACCOUNT_NUMBER reaches the bank and never appears in SePay at all.
# Set this to the VA from my.sepay.vn and the payer is quoted it instead. Leave
# empty for banks that accept the master account directly.
SEPAY_VIRTUAL_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_PAYMENT_PREFIX=AGM
# How old a signed webhook may be. Keep it generous: SePay retries a delivery it
# considers failed, and a retry that arrives after this window is rejected even
# though the customer really paid. Replay is stopped by the transaction id, not
# by this value.
SEPAY_WEBHOOK_MAX_AGE_SECONDS=3600
SEPAY_ORDER_TTL_MINUTES=30
SEPAY_SUBSCRIPTION_DAYS=30

# VPS production example:
# DEBUG=False
# ALLOWED_HOSTS=api.agromind.farm
# FRONTEND_ORIGIN=https://agromind.farm
# CORS_ALLOWED_ORIGINS=https://agromind.farm,https://www.agromind.farm
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$
# CSRF_TRUSTED_ORIGINS=https://api.agromind.farm,https://agromind.farm,https://www.agromind.farm

# Shared secret for POST /api/maintenance/housekeeping/, which the GitHub Actions
# scheduled housekeeping calls. Leave empty and the
# endpoint refuses everyone. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MAINTENANCE_TOKEN=

# --------------------------------------------------------------- AI providers
# These used to exist only as Vercel environment variables, read by
# src/app/api/chat/route.ts and src/app/api/research-symptoms/route.ts. The
# Android app cannot hold a provider key and must not use the website as a
# secret-holding backend, so the orchestration now lives in backend/aiproviders/
# and these have to be set here.
#
# Leave them empty and nothing breaks silently: /api/diagnoses/research-symptoms/
# and /api/engagement/chat/respond/ answer 503, and /api/mobile/config/ reports
# the feature as off so the app hides it instead of offering something that fails.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
TAVILY_API_KEY=

# How long a client_request_id keeps returning the answer it bought. Two days
# covers a phone that was out of signal overnight.
CLIENT_REQUEST_TTL_HOURS=48

# Ceiling for POST /api/diagnoses/cnn-multipart/. The app downscales to a
# ~1600-2048px long edge before uploading, so anything near this is an
# unprocessed original.
DIAGNOSIS_IMAGE_MAX_BYTES=8388608

# ------------------------------------------------------- Mobile app switches
# Served by GET /api/mobile/config/, which the app reads before its first screen.
# MOBILE_MIN_SUPPORTED_VERSION is a force-update floor: a build with a lower
# versionCode is told to update rather than failing against a contract it no
# longer speaks.
MOBILE_MIN_SUPPORTED_VERSION=1
MOBILE_LATEST_VERSION=1
MOBILE_MAINTENANCE=False
MOBILE_MAINTENANCE_MESSAGE=
MOBILE_SUPPORT_URL=
# ------------------------------------------------------------- Google Play
# Only needed for the `play` flavour. While the service-account file is unset,
# GOOGLE_PLAY_BILLING_ENABLED is forced False, /api/payments/google-play/verify/
# answers 503, and the Play build hides its purchase CTA rather than falling
# back to a bank transfer — which Play policy does not permit.
#
# The service-account JSON lives on the VPS with permission 600 and is NEVER
# committed and NEVER packaged into the APK.
GOOGLE_PLAY_BILLING_ENABLED=False
GOOGLE_PLAY_PACKAGE_NAME=vn.agromind.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
# Product ids as created in the Play Console. They cannot be renamed once
# published, so they are configuration rather than something to derive.
GOOGLE_PLAY_PRODUCT_GROW=
GOOGLE_PLAY_BASE_PLAN_GROW=
GOOGLE_PLAY_PRODUCT_BLOOM=
GOOGLE_PLAY_BASE_PLAN_BLOOM=
GOOGLE_PLAY_PRODUCT_ELITE=
GOOGLE_PLAY_BASE_PLAN_ELITE=
# Shared secret for the Pub/Sub push endpoint that receives real-time developer
# notifications. This endpoint can end a paying grower's plan, so leaving it
# empty makes it refuse everyone. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GOOGLE_PLAY_RTDN_TOKEN=
