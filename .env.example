# Frontend environment for Vercel/local Next.js.
# Local Django:
DJANGO_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
TAVILY_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Microsoft Clarity project id (public, from https://clarity.microsoft.com/projects). A default is baked into the app and only loads in production builds; set this only to point at a different Clarity project.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Production example after Render backend is live:
# DJANGO_BASE_URL=https://webchuandoanla-backend.onrender.com
# NEXT_PUBLIC_API_BASE_URL=https://webchuandoanla-backend.onrender.com
# DEEPSEEK_API_KEY=<set in Vercel, do not commit>
# DEEPSEEK_MODEL=deepseek-v4-flash
# TAVILY_API_KEY=<set in Vercel, do not commit>
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=<Google OAuth Web Client ID>

# Backend environment for Render:
# DJANGO_SUPERUSER_USERNAME=<set only in Render>
# DJANGO_SUPERUSER_EMAIL=<set only in Render>
# DJANGO_SUPERUSER_PASSWORD=<set only in Render>
# GOOGLE_CLIENT_ID=<same Google OAuth Web Client ID>
# SEPAY_WEBHOOK_SECRET=<random 32-byte secret; configure the same value in SePay>
# SEPAY_API_KEY=<temporary fallback only while migrating from API Key authentication>
# SEPAY_BANK_CODE=BIDV
# SEPAY_BANK_NAME=BIDV
# SEPAY_ACCOUNT_NUMBER=<recipient bank account number>
# SEPAY_ACCOUNT_NAME=<recipient account holder name>
# SEPAY_PAYMENT_PREFIX=AGM
# SEPAY_WEBHOOK_MAX_AGE_SECONDS=300
# SEPAY_ORDER_TTL_MINUTES=30
# Days one purchase buys. This is the campaign switch: raising it to 90 grants
# 90 days on the next activation and makes the whole promotional surface appear.
# Lower it back and everyone who already bought keeps the term they paid for,
# because plan_expires_at is written once at activation.
# SEPAY_SUBSCRIPTION_DAYS=30

# Campaign presentation, read on the Vercel/frontend side. These control how
# loudly the offer is shown; they cannot make the site claim a term the backend
# is not granting — the surfaces check the live catalogue and stay hidden when
# SEPAY_SUBSCRIPTION_DAYS is back to its standard value.
# Deliberately NOT NEXT_PUBLIC_: those are inlined at build time, which would
# make every change a redeploy instead of taking effect on the next revalidation.
#
# UNSET MEANS ON. The variable exists to turn the campaign off or to scope it.
# CAMPAIGN_ENABLED=1
# End of the campaign, as a gate — no date is ever rendered. MUST carry an
# explicit offset; a bare date is read as UTC and would end a Vietnamese
# campaign seven hours early.
# CAMPAIGN_ENDS_AT=2026-08-31T23:59:59+07:00
# Never shown to users. Identity for analytics.
# CAMPAIGN_ID=term-2026q3
# Which surfaces may render. Unset means all of them. Use to quieten the
# campaign without a deploy, e.g. CAMPAIGN_SURFACES=band drops the hero line.
# CAMPAIGN_SURFACES=hero,band
